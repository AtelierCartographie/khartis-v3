# =============================================================================
# Environment Configuration
# =============================================================================
#
# Three environments:
# 1. LOCAL (development): BASE_PATH empty → app at http://localhost:5176/
# 2. PPRD (pre-production): BASE_PATH=/cartographie/khartisnewpprd
# 3. PRD (production): BASE_PATH=/cartographie/khartisnewprd
#
# GitHub Actions automatically set BASE_PATH during CI/CD builds.
# This file (.env) is for local development only.
#
# To build locally for a specific environment:
#   BASE_PATH=/cartographie/khartisnewpprd pnpm build  # PPRD
#   BASE_PATH=/cartographie/khartisnewprd pnpm build   # PRD
# =============================================================================

BASE_PATH=/cartographie/khartisnewpprd

# Legacy debug flag (kept for compatibility)
VITE_DEBUG_AUTH=true

# New logging system configuration
# Enable/disable logging (auto-enabled in development mode)
VITE_DEBUG=true

# Log categories (comma-separated or 'all')
# Available: AUTH, PERSIST, CACHE, LOAD, SYNC, TEST_MODE, NOTIFICATION, FILE, DATA, STORE, DUCKDB, PROJECT, VISUALIZATION, MAP, UI, EXPORT, IMPORT, GEOLOCATION, JOIN, ERROR
VITE_LOG_CATEGORIES=all

# Minimum log level (DEBUG, INFO, WARN, ERROR, SUCCESS)
VITE_LOG_LEVEL=DEBUG

# Include stack traces in error logs
VITE_LOG_STACK=false
