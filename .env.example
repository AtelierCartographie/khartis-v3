# =============================================================================
# Copy this file to `.env` (gitignored) and fill in your values.
# =============================================================================

# Path where the SPA is served (dev + FTP staging share the same value).
BASE_PATH=/cartographie/khartisnewpprd

# Displayed in the side nav, also used as PostHog release version on errors.
VITE_APP_VERSION=v1.6.0-staging.1

# Logging (verbose in dev, lower in prod is fine).
VITE_DEBUG=true
VITE_LOG_CATEGORIES=all
VITE_LOG_LEVEL=DEBUG
VITE_LOG_STACK=true

# Google Analytics (optional, leave empty to disable).
PUBLIC_GA_MEASUREMENT_ID=

# --- PostHog ---------------------------------------------------------------
# PostHog only initialises during `pnpm build` (vite mode === 'production').
# `pnpm dev` ignores PUBLIC_POSTHOG_KEY entirely, so you can safely keep your
# real key here without sending dev events.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- PostHog sourcemap upload (used by `pnpm release:build`) --------------
# POSTHOG_CLI_API_KEY is a PERSONAL API key (phs_…), from Settings > User > Personal API keys.
# POSTHOG_CLI_PROJECT_ID is the numeric project id from Settings > Project.
# Alternative: run `npx @posthog/cli login` once and skip these vars.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
