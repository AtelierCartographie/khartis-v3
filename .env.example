# =============================================================================
# Copy this file to `.env` (gitignored) and fill in your values.
# =============================================================================

# Path where the SPA is served (dev + FTP staging share the same value).
BASE_PATH=/cartographie/khartisnewpprd

# Displayed in the side nav.
VITE_APP_VERSION=v1.6.0-staging.1

# Logging (verbose in dev, lower in prod is fine).
VITE_DEBUG=true
VITE_LOG_CATEGORIES=all
VITE_LOG_LEVEL=DEBUG
VITE_LOG_STACK=true

# Google Analytics (optional, leave empty to disable).
PUBLIC_GA_MEASUREMENT_ID=
