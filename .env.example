# Legacy debug flag (kept for compatibility)
VITE_DEBUG_AUTH=true

# New logging system configuration
# Enable/disable logging (auto-enabled in development mode)
VITE_DEBUG=true

# Log categories (comma-separated or 'all')
# Available: AUTH, PERSIST, CACHE, LOAD, SYNC, TEST_MODE, NOTIFICATION, FILE, DATA, STORE, DUCKDB, PROJECT, VISUALIZATION, MAP, UI, EXPORT, IMPORT, GEOLOCATION, JOIN, ERROR
VITE_LOG_CATEGORIES=all

# Minimum log level (DEBUG, INFO, WARN, ERROR, SUCCESS)
VITE_LOG_LEVEL=DEBUG

# Include stack traces in error logs
VITE_LOG_STACK=false
