{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routes/**/*.svelte",
    "src/routes/**/+*.{js,ts}",
    "src/sw.ts",
    "pwa-assets.config.js",
    "scripts/**/*.sh",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,js,svelte,css,scss}"],
  "ignore": [
    "src/lib/features/data-pipeline/__tests__/test-file-loader.ts",
    "src/lib/paraglide/**/*",
    "src/lib/features/create-project/index.ts",
    "src/lib/features/data-tab/index.ts",
    "src/lib/features/header/index.ts",
    "src/lib/features/map/index.ts",
    "src/lib/features/side-nav/index.ts",
    "src/lib/features/step-toolbar/index.ts",
    "src/lib/features/step-toolbar/tools/search/index.ts",
    "src/lib/features/visualization-tab/index.ts",
    "src/lib/features/map/layers/density-layer-factory.ts"
  ],
  "ignoreDependencies": [
    "@fontsource/cabin",
    "@fontsource/ibm-plex-sans",
    "@fontsource/inter",
    "@fontsource/lato",
    "@fontsource/noto-sans",
    "@fontsource/open-sans"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "enumMembers": "off"
  }
}
