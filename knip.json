{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routes/**/*.svelte",
    "src/routes/**/+*.{js,ts}",
    "src/hooks.server.ts",
    "src/app.d.ts",
    "vite.config.ts",
    "svelte.config.js",
    "playwright.config.ts",
    "eslint.config.js",
    "pwa-assets.config.js",
    "commitlint.config.js",
    "scripts/**/*.sh"
  ],
  "project": ["src/**/*.{ts,js,svelte}"],
  "ignore": [
    "**/*.d.ts",
    "src/lib/features/data-pipeline/__tests__/test-file-loader.ts",
    "src/paraglide/**/*.js",
    "src/paraglide/runtime.js",
    "src/paraglide/server.js",
    "src/paraglide/registry.js"
  ],
  "ignoreDependencies": ["@commitlint/cli", "@inlang/paraglide-js"],
  "ignoreBinaries": ["semantic-release", "run"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "enumMembers": "off"
  }
}
