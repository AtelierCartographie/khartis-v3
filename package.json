{
  "name": "khartis-v3",
  "private": true,
  "version": "0.0.0-semantically-released",
  "license": "MIT",
  "description": "Client-side thematic mapping application: import tabular or geographic data, join it to a basemap, classify it and export publication-ready maps, entirely in the browser.",
  "keywords": [
    "cartography",
    "thematic-map",
    "choropleth",
    "data-visualization",
    "geospatial",
    "duckdb-wasm",
    "deck.gl",
    "geoarrow",
    "svelte"
  ],
  "homepage": "https://www.sciencespo.fr/cartographie/outils/khartis/app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtelierCartographie/khartis-v3.git"
  },
  "bugs": {
    "url": "https://github.com/AtelierCartographie/khartis-v3/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22 <27",
    "pnpm": ">=10"
  },
  "contributors": [
    {
      "name": "Thomas Ansart",
      "url": "https://www.sciencespo.fr/cartographie/"
    },
    {
      "name": "Antoine Rio",
      "url": "https://www.sciencespo.fr/cartographie/"
    },
    {
      "name": "Jean-Baptiste Thery",
      "email": "jb.thery@jcode.works",
      "url": "https://github.com/jb-thery"
    }
  ],
  "release": {
    "branches": [
      {
        "name": "main"
      },
      {
        "name": "staging",
        "prerelease": "pprd"
      }
    ]
  },
  "scripts": {
    "dev": "vite dev --port 5176",
    "build": "NODE_ENV=production vite build",
    "download:extensions": "bash scripts/download-duckdb-extensions.sh",
    "thumbnails:basemap-styles": "node scripts/generate-basemap-style-thumbnails.mjs",
    "deploy:pprd": "bash scripts/deploy-local.sh pprd",
    "deploy:pprd:dry-run": "bash scripts/deploy-local.sh pprd --dry-run --yes",
    "deploy:prod": "bash scripts/deploy-local.sh prod",
    "deploy:prod:dry-run": "bash scripts/deploy-local.sh prod --dry-run --yes",
    "preview": "vite preview",
    "postinstall": "bash scripts/download-duckdb-extensions.sh",
    "prepare": "husky",
    "machine-translate": "npx inlang machine translate --project ./project.inlang",
    "compile:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "check": "pnpm compile:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm compile:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check \"*.{js,json,md,ts,svelte,yml,yaml}\" \".prettierrc\" \".github/**/*.{yml,yaml,json,md}\" \"docs/**/*.{md,json,yml,yaml}\" \"messages/**/*.json\" \"project.inlang/**/*.json\" \"tests/**/*.{ts,js,json}\" \"tests-datasets/**/*.{json,md,html,js,css}\" \"scripts/**/*.{js,ts,sh,json}\" \"src/**/*.{ts,js,svelte,json}\" \"static/**/*.{json,md,html,js,css}\" --ignore-unknown && eslint .",
    "test:all": "pnpm test:unit && pnpm test:pipeline && pnpm test:duckdb",
    "test:duckdb": "vitest run --project server tests/duckdb --reporter=agent --passWithNoTests",
    "test:pipeline": "vitest run --project server tests/pipeline --reporter=agent --passWithNoTests",
    "test:unit": "vitest run --project client --reporter=agent",
    "reset:packages": "find . -type dir -name node_modules | xargs rm -rf && rm -rf pnpm-lock.yaml",
    "ragmir": "pnpm --filter @khartis/ragmir-tooling exec rgr --project-root ../..",
    "update:packages": "pnpm update --interactive --latest",
    "generate-pwa-assets": "pwa-assets-generator",
    "init:project": "npx husky init && pnpm install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@duckdb/node-api": "1.5.6-r.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.7.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "carbon-preprocess-svelte": "^0.11.63",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "rollup-plugin-visualizer": "^7.3.0",
    "sass-embedded": "^1.108.2",
    "semantic-release": "^25.0.9",
    "ssh2-sftp-client": "^12.1.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@ateliercartographie/geoarrow-deck-stream": "^1.2.1",
    "@ateliercartographie/label-placer": "^0.5.0",
    "@ateliercartographie/motif.js": "^0.1.5",
    "@ateliercartographie/ok-palette": "^0.4.0",
    "@ateliercartographie/proj-suggest": "^0.1.0",
    "@borgar/textbox": "^2.0.0",
    "@deck.gl/core": "^9.4.2",
    "@deck.gl/extensions": "^9.4.2",
    "@deck.gl/layers": "^9.4.2",
    "@deck.gl/mapbox": "^9.4.2",
    "@duckdb/duckdb-wasm": "1.33.1-dev65.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cabin": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@luma.gl/core": "9.4.2",
    "@math.gl/core": "^4.1.1",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@uwdata/flechette": "^2.8.1",
    "apache-arrow": "^21.2.0",
    "carbon-components-svelte": "^0.113.2",
    "carbon-icons-svelte": "^13.18.2",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "d3-geo-polygon": "^2.0.1",
    "d3-geo-projection": "^4.0.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "localforage": "^1.10.0",
    "maplibre-gl": "^6.19.0",
    "parquet-wasm": "^0.9.0",
    "proj4": "^2.23.0",
    "svelte-dnd-action": "^0.9.81",
    "topojson-client": "^3.1.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,css,scss,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402"
}
