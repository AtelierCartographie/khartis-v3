{
  "name": "khartis-v3",
  "private": true,
  "version": "1.6.0-staging.2",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "contributors": [
    {
      "name": "Thomas Ansart",
      "url": "https://www.sciencespo.fr/cartographie/"
    },
    {
      "name": "Antoine Rio",
      "url": "https://www.sciencespo.fr/cartographie/"
    },
    {
      "name": "Jean-Baptiste Thery",
      "email": "jb.thery@jcode.works",
      "url": "https://github.com/jb-thery"
    }
  ],
  "release": {
    "branches": [
      {
        "name": "main"
      },
      {
        "name": "staging",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer"
    ]
  },
  "scripts": {
    "dev": "vite dev --port 5176",
    "build": "NODE_ENV=production vite build",
    "download:extensions": "bash scripts/download-duckdb-extensions.sh",
    "preview": "vite preview",
    "postinstall": "bash scripts/download-duckdb-extensions.sh",
    "prepare": "husky",
    "machine-translate": "npx inlang machine translate --project ./project.inlang",
    "compile:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "check": "pnpm compile:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm compile:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:all": "pnpm test:unit && pnpm test:pipeline && pnpm test:duckdb",
    "test:duckdb": "vitest run --project server tests/duckdb --reporter=agent --passWithNoTests",
    "test:pipeline": "vitest run --project server tests/pipeline --reporter=agent --passWithNoTests",
    "test:unit": "vitest run --project client --reporter=agent",
    "reset:packages": "find . -type dir -name node_modules | xargs rm -rf && rm -rf pnpm-lock.yaml",
    "update:packages": "pnpm update --interactive --latest",
    "generate-pwa-assets": "pwa-assets-generator",
    "init:project": "npx husky init && pnpm install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@duckdb/node-api": "1.5.2-r.1",
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.1.9",
    "@math.gl/polygon": "4.1.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.6.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "carbon-preprocess-svelte": "^0.11.29",
    "earcut": "3.0.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "knip": "^6.6.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.98.0",
    "semantic-release": "^25.0.3",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.0"
  },
  "dependencies": {
    "@ateliercartographie/motif.js": "^0.1.5",
    "@ateliercartographie/ok-palette": "^0.1.4",
    "@borgar/textbox": "^2.0.0",
    "@deck.gl/core": "^9.3.1",
    "@deck.gl/extensions": "^9.3.1",
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "@duckdb/duckdb-wasm": "1.33.1-dev45.0",
    "@fontsource/cabin": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/open-sans": "^5.2.7",
    "@inlang/paraglide-js": "^2.16.0",
    "@luma.gl/core": "9.3.3",
    "@math.gl/core": "^4.1.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@uwdata/flechette": "^2.4.0",
    "apache-arrow": "^21.1.0",
    "carbon-components": "10.58.15",
    "carbon-components-svelte": "^0.106.2",
    "carbon-icons-svelte": "^13.10.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "fflate": "^0.8.2",
    "geoarrow-deck-stream": "github:AtelierCartographie/geoarrow-deck-stream#v1.0.2",
    "html-to-image": "^1.11.13",
    "localforage": "^1.10.0",
    "maplibre-gl": "^5.24.0",
    "parquet-wasm": "^0.7.1",
    "proj-suggest": "github:AtelierCartographie/proj-suggest",
    "proj4": "^2.20.4",
    "svelte-dnd-action": "^0.9.69",
    "vite-plugin-pwa": "^1.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "geoarrow-deck-stream",
      "proj-suggest"
    ],
    "overrides": {
      "rollup": "4.60.0",
      "fast-xml-parser": ">=4.5.4",
      "serialize-javascript": ">=7.0.3",
      "tar": ">=7.5.11",
      "cookie": ">=0.7.0"
    }
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,css,scss,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402"
}
