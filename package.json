{
  "name": "khartis-v3",
  "private": true,
  "version": "1.6.0-staging.29",
  "license": "MIT",
  "homepage": "https://www.sciencespo.fr/cartographie/khartis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtelierCartographie/khartis-v3.git"
  },
  "bugs": {
    "url": "https://github.com/AtelierCartographie/khartis-v3/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "contributors": [
    {
      "name": "Thomas Ansart",
      "url": "https://www.sciencespo.fr/cartographie/"
    },
    {
      "name": "Antoine Rio",
      "url": "https://www.sciencespo.fr/cartographie/"
    },
    {
      "name": "Jean-Baptiste Thery",
      "email": "jb.thery@jcode.works",
      "url": "https://github.com/jb-thery"
    }
  ],
  "release": {
    "branches": [
      {
        "name": "main"
      },
      {
        "name": "staging",
        "prerelease": "pprd"
      }
    ]
  },
  "scripts": {
    "dev": "vite dev --port 5176",
    "build": "NODE_ENV=production vite build",
    "download:extensions": "bash scripts/download-duckdb-extensions.sh",
    "deploy:pprd": "bash scripts/deploy-local.sh pprd",
    "deploy:pprd:dry-run": "bash scripts/deploy-local.sh pprd --dry-run --yes",
    "deploy:prod": "bash scripts/deploy-local.sh prod",
    "deploy:prod:dry-run": "bash scripts/deploy-local.sh prod --dry-run --yes",
    "preview": "vite preview",
    "postinstall": "bash scripts/download-duckdb-extensions.sh",
    "prepare": "husky",
    "machine-translate": "npx inlang machine translate --project ./project.inlang",
    "compile:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "check": "pnpm compile:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm compile:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check \"*.{js,json,md,ts,svelte,yml,yaml}\" \".prettierrc\" \".github/**/*.{yml,yaml,json,md}\" \"docs/**/*.{md,json,yml,yaml}\" \"messages/**/*.json\" \"project.inlang/**/*.json\" \"tests/**/*.{ts,js,json}\" \"scripts/**/*.{js,ts,sh,json}\" \"src/**/*.{ts,js,svelte,json}\" \"static/**/*.{json,md,html,js,css}\" --ignore-unknown && eslint .",
    "test:all": "pnpm test:unit && pnpm test:pipeline && pnpm test:duckdb",
    "test:duckdb": "vitest run --project server tests/duckdb --reporter=agent --passWithNoTests",
    "test:pipeline": "vitest run --project server tests/pipeline --reporter=agent --passWithNoTests",
    "test:unit": "vitest run --project client --reporter=agent",
    "reset:packages": "find . -type dir -name node_modules | xargs rm -rf && rm -rf pnpm-lock.yaml",
    "update:packages": "pnpm update --interactive --latest",
    "generate-pwa-assets": "pwa-assets-generator",
    "init:project": "npx husky init && pnpm install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@duckdb/node-api": "1.5.4-r.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.1.15",
    "@jcode.labs/ragmir": "^2.13.1",
    "@jcode.labs/ragmir-chat": "2.13.1",
    "@jcode.labs/ragmir-tts": "2.13.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vite-pwa/assets-generator": "^1.0.2",
    "carbon-preprocess-svelte": "^0.11.37",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.100.0",
    "semantic-release": "^25.0.7",
    "ssh2-sftp-client": "^12.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@ateliercartographie/geoarrow-deck-stream": "^1.1.3",
    "@ateliercartographie/motif.js": "^0.1.5",
    "@ateliercartographie/ok-palette": "^0.1.4",
    "@ateliercartographie/proj-suggest": "^0.0.1",
    "@borgar/textbox": "^2.0.0",
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/extensions": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@deck.gl/mapbox": "^9.3.6",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@fontsource/cabin": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-arabic": "^5.2.10",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/open-sans": "^5.2.7",
    "@inlang/paraglide-js": "^2.22.0",
    "@luma.gl/core": "9.3.6",
    "@math.gl/core": "^4.1.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@uwdata/flechette": "^2.5.0",
    "apache-arrow": "^21.1.0",
    "carbon-components-svelte": "^0.110.0",
    "carbon-icons-svelte": "^13.13.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-geo-polygon": "^2.0.1",
    "d3-geo-projection": "^4.0.0",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "localforage": "^1.10.0",
    "maplibre-gl": "^5.24.0",
    "parquet-wasm": "^0.7.2",
    "proj4": "^2.20.9",
    "svelte-dnd-action": "^0.9.74",
    "topojson-client": "^3.1.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,css,scss,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402"
}
