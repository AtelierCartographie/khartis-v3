{
  "name": "khartis-v3",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "contributors": [
    {
      "name": "Jean-Baptiste Thery",
      "email": "jb.thery@jcode.works",
      "url": "https://github.com/jb-thery"
    }
  ],
  "release": {
    "branches": [
      {
        "name": "main"
      },
      {
        "name": "develop",
        "prerelease": true
      }
    ]
  },
  "scripts": {
    "dev": "vite dev --port 5176",
    "build": "NODE_ENV=production vite build",
    "download:extensions": "bash scripts/download-duckdb-extensions.sh",
    "preview": "vite preview",
    "postinstall": "bash scripts/download-duckdb-extensions.sh",
    "prepare": "husky",
    "machine-translate": "npx inlang machine translate --project ./project.inlang",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "pnpm run test:unit -- --run && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "reset:packages": "find . -type dir -name node_modules | xargs rm -rf && rm -rf pnpm-lock.yaml",
    "update:packages": "pnpm update --interactive",
    "generate-pwa-assets": "pwa-assets-generator",
    "init:project": "npx husky init && pnpm install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@inlang/cli": "^3.0.12",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.3",
    "carbon-preprocess-svelte": "^0.11.16",
    "duckdb": "^1.4.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "sass-embedded": "^1.97.0",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.2.5",
    "@deck.gl/core": "^9.2.5",
    "@deck.gl/extensions": "^9.2.5",
    "@deck.gl/geo-layers": "^9.2.5",
    "@deck.gl/layers": "^9.2.5",
    "@deck.gl/mapbox": "^9.2.5",
    "@deck.gl/mesh-layers": "^9.2.5",
    "@duckdb/duckdb-wasm": "1.31.0",
    "@geoarrow/deck.gl-layers": "^0.3.1",
    "@geoarrow/geoparquet-wasm": "0.2.0-beta.5",
    "@inlang/paraglide-js": "^2.7.0",
    "@observablehq/plot": "^0.6.17",
    "@uwdata/flechette": "^2.2.6",
    "apache-arrow": "^21.1.0",
    "carbon-components-svelte": "^0.96.0",
    "carbon-icons-svelte": "^13.7.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "fflate": "^0.8.2",
    "localforage": "^1.10.0",
    "maplibre-gl": "^5.14.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402"
}
